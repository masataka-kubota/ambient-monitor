{
  "name": "backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ip": "wrangler dev --ip 0.0.0.0",
    "build:types": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && open coverage/index.html",
    "db:generate": "drizzle-kit generate",
    "db:migration:local": "wrangler d1 migrations apply ambient-monitor --local",
    "db:migration:remote": "wrangler d1 migrations apply ambient-monitor --remote",
    "db:studio:local": "drizzle-kit studio --config drizzle.config.local-studio.ts",
    "db:studio:remote": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@hono/eslint-config": "^2.1.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-drizzle": "^0.2.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
