    "@types/jest": "29.5.14",
    "@types/node": "^24.12.0",
    "@types/react": "~19.2.18",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.78.0",
    "oxlint-config-universe": "^0.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
